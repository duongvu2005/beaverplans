#!/bin/sh
# Fast gates only — lint and the test suite run in CI (.github/workflows/ci.yml).
# Checks the working tree, not the staged snapshot, so unrelated unfinished work
# blocks a commit too; `git commit --no-verify` skips it.

if ! npx tsc -b; then
    printf '\npre-commit: typecheck failed. vitest does not typecheck, so this is the only local gate on type errors in tests.\n'
    exit 1
fi

if ! npm run --silent format:check; then
    printf '\npre-commit: formatting. Fix with: npm run format\n'
    exit 1
fi
